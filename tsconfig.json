{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"target": "ES2020",
		"outDir": "bin",
		"removeComments": true,
		"preserveConstEnums": true,
		"declaration": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"lib": [
			"ES2020"
		]
	},
	"include": [
		"src"
	],
	"exclude": [
		"node_modules",
		"demo"
	]
}